{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisca",
  "version": "0.1.1",
  "identifier": "com.crofty.prisca",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prisca",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#16171a",
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Crofty",
    "category": "Utility",
    "shortDescription": "Fast scanning for any scanner or all-in-one printer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright (C) 2026 Crofty. GPL-3.0-or-later.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMENCMkU1QjhERDQxNzMKUldSelFkMjQ1YklNL2Zvaml2cFUyaGRNeW1rYkJkWXQ1MDdNbHVvYlJXMHlRb2dtU3NTVi9iSGwK",
      "endpoints": [
        "https://github.com/sanyamgoelx/prisca/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
